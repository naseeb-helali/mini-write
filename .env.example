# ==========================================================
# 🌐 LOBAL CONFIGURATION
# ==========================================================
PROJECT_NAME=mini-write
NODE_ENV=production
HTTP_PORT=80

# ==========================================================
# 🐘 DATABASE CONFIGURATION (PostgreSQL)
# ==========================================================
# Note: These values ​​must match what the API and container are expecting.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=miniwrite_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=miniwrite_db

# ==========================================================
# 🧠 CACHE & QUEUE CONFIGURATION (Redis)
# ==========================================================
REDIS_HOST=redis
REDIS_PORT=6379
# In a production environment, it is recommended to add a password to Redis.
REDIS_PASSWORD=CHANGE_ME

# ==========================================================
# 📦 OBJECT STORAGE CONFIGURATION (MinIO)
# ==========================================================
# These are the credentials you will use to access the S3 API.
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_ENDPOINT=mw-storage
MINIO_PORT=9000
MINIO_BUCKET_NAME=user-documents
MINIO_PROCESSED_BUCKET=processed-docs

# ==========================================================
# 📦 GRAFANA CONFIGURATION (Observability)
# ==========================================================
GRAFANA_ADMIN_PASSWORD=change_me

# ==========================================================
# 🔐 SECURITY & AUTHENTICATION
# ==========================================================
# The secret of JWT encryption (never share it)
JWT_SECRET=CHANGE_ME_SUPER_SECRET # Required for authMiddleware.
JWT_EXPIRY=24h # Referenced in auth.test.js 

# ==========================================================
# ⚙️ WORKER SETTINGS
# ==========================================================
# Number of attempts to redo the task in case of failure
WORKER_RETRY_LIMIT=3
WORKER_CONCURRENCY=2
QUEUE_NAME=document_processing
