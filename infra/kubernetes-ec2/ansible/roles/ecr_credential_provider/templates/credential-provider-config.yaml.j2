apiVersion: kubelet.config.k8s.io/v1
kind: CredentialProviderConfig

providers:
  - name: {{ ecr_credential_provider_name }}
    matchImages:
      - "{{ ecr_credential_provider_registry }}"
    defaultCacheDuration: "{{ ecr_credential_provider_default_cache_duration }}"
    apiVersion: credentialprovider.kubelet.k8s.io/v1
