#!/bin/bash

# ==========================================================
# Mini-Write Deployment Runtime Orchestrator
# ==========================================================
#
# Responsibilities
#
#   • Coordinate deployment workflow
#   • Load runtime modules
#   • Propagate execution status
#
# Non Responsibilities
#
#   • Validation Logic
#   • Docker Operations
#   • Health Verification
#   • Recovery Logic
#   • State Management
#   • Deployment Telemetry
#   • Runtime Cleanup
#
# All operational logic belongs to runtime modules.
#
# ==========================================================

set -Eeuo pipefail

LOCK="/var/lock/deploy.lock"
STATE="{{ deploy_root }}/state/deployment_state.json"
LOG="{{ deploy_root }}/logs/deploy.log"
ENV_FILE="{{ deploy_root }}/env/.env.staging"

# =========================
# Runtime Modules
# =========================

source "{{ deploy_root }}/scripts/runtime/state.sh"

source "{{ deploy_root }}/scripts/runtime/preflight.sh"

source "{{ deploy_root }}/scripts/runtime/executor.sh"

source "{{ deploy_root }}/scripts/runtime/verifier.sh"

source "{{ deploy_root }}/scripts/runtime/recovery.sh"

source "{{ deploy_root }}/scripts/runtime/telemetry.sh"

source "{{ deploy_root }}/scripts/runtime/metrics.sh"

source "{{ deploy_root }}/scripts/runtime/cleanup.sh"

# =========================
# Deployment Context
# =========================
NEW_API=$1
NEW_WORKER=$2

cd {{ deploy_root }}/compose
mkdir -p {{ deploy_root }}/logs

exec >> {{ deploy_root }}/logs/deploy.log 2>&1
echo ""
echo "================================================"
echo "$(date) - Starting deployment"
echo "API_IMAGE=$NEW_API"
echo "WORKER_IMAGE=$NEW_WORKER"
echo "================================================"

metrics_begin_session

if [ $? -ne 0 ]; then

    deployment_error \
        "$LOG" \
        "Metrics runtime initialization failed."

    exit 1

fi

deployment_start_time="$(runtime_now)"

# ==========================================================
# Deployment Workflow
# ==========================================================

run_preflight \
    "$LOG" \
    "$NEW_API" \
    "$NEW_WORKER" \
    "$ENV_FILE"

if [ $? -ne 0 ]; then
    deployment_error \
        "$LOG" \
        "Preflight validation failed."

    fail_deployment_session \
        "$deployment_start_time"

    exit 1
fi

# =========================
# Load state
# =========================
load_state "$LOG"

CURRENT_API="$(get_current_api)"
CURRENT_WORKER="$(get_current_worker)"

# =========================
# Deploy
# =========================
export API_IMAGE=$NEW_API
export WORKER_IMAGE=$NEW_WORKER

deployment_info \
    "$LOG" \
    "Pulling images..."

deployment_info \
    "$LOG" \
    "Deploying containers..."

run_deployment \
    "$LOG" \
    "{{ deploy_root }}/compose/docker-compose.staging.yml" \
    "$ENV_FILE"

if [ $? -ne 0 ]; then
    deployment_error \
        "$LOG" \
        "Deployment execution failed."

    fail_deployment_session \
        "$deployment_start_time"

    exit 1
fi

# =========================
# System-level Health Check (HTTP-based)
# =========================
deployment_info \
    "$LOG" \
    "Running health verification..."

run_health_verification \
    "$LOG" \
    "http://localhost/health/ready"

if [ $? -ne 0 ]; then

    deployment_error \
        "$LOG" \
        "Health verification failed."

    handle_failed_deployment "$LOG"

    fail_deployment_session \
        "$deployment_start_time"

    exit 1

fi

deployment_success \
    "$LOG" \
    "Deployment completed successfully."

update_state \
    "$LOG" \
    "$NEW_API" \
    "$NEW_WORKER"

if [ $? -ne 0 ]; then
    deployment_error \
        "$LOG" \
        "Failed to update deployment state."

    handle_failed_deployment "$LOG"

    fail_deployment_session \
        "$deployment_start_time"

    exit 1
fi

# ==========================================================
# Deployment Finalization
# ==========================================================
deployment_info \
    "$LOG" \
    "Cleaning unused Docker images..."

cleanup_images "$LOG"

if [ $? -ne 0 ]; then

    deployment_warning \
        "$LOG" \
        "Docker image cleanup failed."

fi

complete_deployment_session \
    "$deployment_start_time"

if [ $? -ne 0 ]; then

    deployment_warning \
        "$LOG" \
        "Metrics export failed."

fi