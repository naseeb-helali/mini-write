version: "3.9"

# =====================================================================
# NETWORKS: Network isolation for security (Layer 4 Isolation)
# =====================================================================
networks:
  frontend-network: # External network for Proxy and API only
    driver: bridge  # In Production Use overlay Instead of bridge or Kubernetes (CNI Plugins) For example (Calico or Flannel) which solve the problem of communication between servers (nodes) automatically and professionally.
  backend-network:  # A completely isolated internal network for rules and Redis
    driver: bridge  # In Production Use overlay Instead of bridge or Kubernetes (CNI Plugins) For example (Calico or Flannel) which solve the problem of communication between servers (nodes) automatically and professionally.
    #internal: true # This feature to prevent any internet disconnection from this network.

# =====================================================================
# VOLUMES: Data persistence
# =====================================================================
volumes:
  postgres_data:
    name: miniwrite_postgres_data
  redis_data:
    name: miniwrite_redis_data
  minio_data:
    name: miniwrite_minio_data
  prometheus_data:
    name: miniwrite_prometheus_data
  grafana_data:
    name: miniwrite_grafana_data
  loki_data:
    name: miniwrite_loki_data
  alertmanager_data:
    name: miniwrite_alertmanager_data
# =====================================================================
# SERVICES: Container dissection
# =====================================================================
services:

  # 1. Gateway (Nginx) - The only gateway to the outside world
  gateway:
    image: nginx:1.25-alpine
    ports:
      - "${HTTP_PORT:-80}:80"
    volumes:
      - {{ deploy_root }}/proxy/nginx.conf:/etc/nginx/nginx.conf:ro
    networks:
      - frontend-network
    depends_on:
      api:
        condition: service_healthy
    restart: always
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    mem_limit: 128m
    cpus: "0.2"

  # 2. Core API - Main Engine (Multi-stage Build)
  api:
    image: ${API_IMAGE}
    env_file:
      - {{ deploy_root }}/env/.env.staging
    environment:
      - NODE_ENV=production
    networks:
      - frontend-network
      - backend-network
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:80/health/ready"]
      interval: 30s
      timeout: 5s
      retries: 3
    restart: always
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    mem_limit: 512m
    cpus: "0.5"

  # 3. Background Worker - Heavy Task Processor
  worker:
    image: ${WORKER_IMAGE}
    env_file:
      - {{ deploy_root }}/env/.env.staging
    networks:
      - backend-network
    depends_on:
      redis:
        condition: service_healthy
      postgres:
        condition: service_healthy
      storage:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "node", "-e", "process.exit(0)"]
      interval: 30s
      timeout: 5s
      retries: 3
    restart: always
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    mem_limit: 1024m
    cpus: "1.0"

  # 5. Cache & Queue (Redis)
  redis:
    image: redis:7-alpine
    command: redis-server --appendonly yes # Ensuring that tasks are not lost upon restart 
    volumes:
      - redis_data:/data
    networks:
      - backend-network
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 5
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    mem_limit: 256m
    cpus: "0.3"
    restart: always

  # 4. Database (PostgreSQL) - State Store
  postgres:
    image: postgres:15-alpine
    shm_size: 128mb # Improving shared memory performance
    env_file:
      - {{ deploy_root }}/env/.env.staging
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - backend-network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB}"]
      interval: 10s
      timeout: 5s
      retries: 5
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    mem_limit: 512m
    cpus: "0.5"
    restart: always

  # 6. Object Storage (MinIO) - S3 emulator
  storage:
    image: minio/minio
    ports:
      - "19000:9000" # API (Internal 9000 -> External 19000)
      - "19001:9001" # Console (Internal 9001 -> External 19001)
    env_file:
      - {{ deploy_root }}/env/.env.staging
    command: server /data --console-address ":9001"
    environment:
      MINIO_ROOT_USER: ${MINIO_ROOT_USER}
      MINIO_ROOT_PASSWORD: ${MINIO_ROOT_PASSWORD}
    volumes:
      - minio_data:/data
    networks:
      - backend-network
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9000/minio/health/live"]
      interval: 30s
      timeout: 20s
      retries: 3
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    mem_limit: 512m

  # 7. Prometheus
  prometheus:
    image: prom/prometheus:v2.53.0
    container_name: mw-prometheus

    restart: always

    ports:
      - "9090:9090"

    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --web.enable-lifecycle

    volumes:
      - ./observability/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./observability/prometheus/rules:/etc/prometheus/rules:ro
      - prometheus_data:/prometheus

    networks:
      - backend-network

    mem_limit: 512m
    cpus: "0.5"

  # 8. Loki
  loki:
    image: grafana/loki:3.0.0
    container_name: mw-loki

    restart: always

    ports:
      - "3100:3100"

    command:
      - -config.file=/etc/loki/config.yml

    volumes:
      - ./observability/loki/config.yml:/etc/loki/config.yml:ro
      - loki_data:/loki

    networks:
      - backend-network

    mem_limit: 512m
    cpus: "0.5"

  # 9. Promtail
  promtail:
    image: grafana/promtail:3.0.0
    container_name: mw-promtail

    restart: always

    command:
      - -config.file=/etc/promtail/config.yml

    volumes:
      - ./observability/promtail/config.yml:/etc/promtail/config.yml:ro
      - /var/lib/docker/containers:/var/lib/docker/containers:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /opt/deploy/logs:/opt/deploy/logs:ro

    depends_on:
      - loki

    networks:
      - backend-network

    mem_limit: 256m
    cpus: "0.3"

  # 10. Alertmanager
  alertmanager:
    image: prom/alertmanager:v0.28.1
    container_name: mw-alertmanager

    restart: always

    ports:
      - "9093:9093"

    command:
      - --config.file=/etc/alertmanager/alertmanager.yml
      - --storage.path=/alertmanager

    volumes:
      - ./observability/alertmanager/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
      - alertmanager_data:/alertmanager

    networks:
      - backend-network

    mem_limit: 256m
    cpus: "0.3"

  # 11. Grafana
  grafana:
    image: grafana/grafana:11.0.0
    container_name: mw-grafana

    restart: always

    ports:
      - "3000:3000"

    environment:
      GF_SECURITY_ADMIN_USER: admin
      GF_SECURITY_ADMIN_PASSWORD: ${GRAFANA_ADMIN_PASSWORD}
      GF_USERS_ALLOW_SIGN_UP: "false"

    volumes:
      - grafana_data:/var/lib/grafana

      - ./observability/grafana/provisioning:/etc/grafana/provisioning:ro

      - ./observability/grafana/dashboards:/var/lib/grafana/dashboards:ro

    depends_on:
      - prometheus
      - loki
      - alertmanager

    networks:
      - backend-network

    mem_limit: 512m
    cpus: "0.5"

# 12. Node-Exporter
  node-exporter:
    image: prom/node-exporter:v1.8.2

    container_name: mw-node-exporter

    restart: always

    command:
      - --path.rootfs=/host
      - --collector.textfile.directory=/host/opt/deploy/metrics

    pid: host

    volumes:
      - /:/host:ro,rslave
      - /opt/deploy/metrics:/host/opt/deploy/metrics:ro

    networks:
      - backend-network

    mem_limit: 128m
    cpus: "0.2"

  # 13. Cadvisor
  cadvisor:
    image: gcr.io/cadvisor/cadvisor:v0.49.1

    container_name: mw-cadvisor

    restart: always

    privileged: true

    devices:
      - /dev/kmsg

    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker:/var/lib/docker:ro
      - /dev/disk:/dev/disk:ro

    networks:
      - backend-network

    mem_limit: 256m
    cpus: "0.3"

  # 14. Redis-Exporter
  redis-exporter:
    image: oliver006/redis_exporter:v1.67.0

    container_name: mw-redis-exporter

    restart: always

    environment:
      REDIS_ADDR: redis://redis:6379

    depends_on:
      redis:
        condition: service_healthy

    networks:
      - backend-network

    mem_limit: 128m
    cpus: "0.2"

  # 15. Postgres-Exporter
  postgres-exporter:
    image: prometheuscommunity/postgres-exporter:v0.15.0

    container_name: mw-postgres-exporter

    restart: always

    environment:
      DATA_SOURCE_NAME: "postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable"

    env_file:
      - {{ deploy_root }}/env/.env.staging

    depends_on:
      postgres:
        condition: service_healthy

    networks:
      - backend-network

    mem_limit: 128m
    cpus: "0.2"
