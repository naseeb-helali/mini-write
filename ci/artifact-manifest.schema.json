{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mini-write.local/schemas/artifact-manifest.schema.json",
  "title": "Mini-Write Artifact Manifest",
  "description": "Immutable release artifact contract for Mini-Write CI/CD.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "source",
    "release",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },

    "project": {
      "type": "string",
      "const": "mini-write"
    },

    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },

    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },

    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api",
        "worker"
      ],
      "properties": {
        "api": {
          "$ref": "#/$defs/containerArtifact"
        },
        "worker": {
          "$ref": "#/$defs/containerArtifact"
        }
      }
    }
  },

  "$defs": {
    "containerArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "tag",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
